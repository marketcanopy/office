{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.marketcanopy.com/office/v1/credential-grant.schema.json",
  "title": "Credential store grant value, version 1 (5.2)",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "apiOrigin": {
      "$ref": "common.schema.json#/$defs/apiOrigin"
    },
    "userId": {
      "$ref": "common.schema.json#/$defs/objectId"
    },
    "deviceSessionId": {
      "$ref": "common.schema.json#/$defs/objectId"
    },
    "installationId": {
      "$ref": "common.schema.json#/$defs/uuidV4"
    },
    "refreshToken": {
      "$ref": "common.schema.json#/$defs/refreshToken"
    },
    "issuedAt": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "writtenBy": {
      "enum": [
        "desktop",
        "office"
      ]
    },
    "lastActiveOrganizationId": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/objectId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "apiOrigin",
    "userId",
    "deviceSessionId",
    "installationId",
    "refreshToken",
    "issuedAt",
    "writtenBy",
    "lastActiveOrganizationId"
  ],
  "additionalProperties": true,
  "description": "Unknown fields are ignored by readers (5.2)."
}
