{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.marketcanopy.com/office/v1/gateway-chat-chunk.schema.json",
  "title": "Streaming chat.completion.chunk event (8.3)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "object": {
      "const": "chat.completion.chunk"
    },
    "created": {
      "type": "integer"
    },
    "model": {
      "$ref": "common.schema.json#/$defs/modelAlias"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "delta": {
            "type": "object",
            "properties": {
              "role": {
                "const": "assistant"
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reasoning_content": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "const": "function"
                    },
                    "function": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "arguments": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "index"
                  ]
                }
              }
            }
          },
          "finish_reason": {
            "oneOf": [
              {
                "enum": [
                  "stop",
                  "length",
                  "tool_calls",
                  "content_filter"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "index",
          "delta"
        ]
      }
    },
    "usage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "total_tokens"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "object",
    "created",
    "model",
    "choices"
  ]
}
