{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.marketcanopy.com/office/v1/gateway-image-request.schema.json",
  "title": "POST <ai.baseUrl>/images/generations accepted subset (8.3, 2.2.0)",
  "type": "object",
  "description": "Fields outside this list are ignored by the gateway and never forwarded, so they are allowed here.",
  "properties": {
    "model": {
      "$ref": "common.schema.json#/$defs/modelAlias"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "n": {
      "const": 1
    },
    "size": {
      "enum": [
        "1024x1024",
        "1536x1024",
        "1024x1536"
      ]
    },
    "response_format": {
      "const": "b64_json"
    }
  },
  "required": [
    "model",
    "prompt"
  ]
}
