{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.marketcanopy.com/office/v1/gateway-image-response.schema.json",
  "title": "POST <ai.baseUrl>/images/generations response (8.3, 2.2.0)",
  "type": "object",
  "properties": {
    "created": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "b64_json": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        },
        "required": [
          "b64_json"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "created",
    "data"
  ],
  "additionalProperties": false
}
