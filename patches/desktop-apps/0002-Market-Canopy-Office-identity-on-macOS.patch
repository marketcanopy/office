 .../Resources/ONLYOFFICE-arm/Info.plist       | 19 +++++++++++--------
 .../Resources/ONLYOFFICE-x86_64/Info.plist    | 19 +++++++++++--------
 macos/fastlane/Fastfile                       |  9 +++++----
 7 files changed, 45 insertions(+), 35 deletions(-)

