diff --git a/common/loginpage/src/routes/about/marketcanopy-notice.css b/common/loginpage/src/routes/about/marketcanopy-notice.css
new file mode 100644
index 0000000..e753d34
--- /dev/null
+++ b/common/loginpage/src/routes/about/marketcanopy-notice.css
@@ -0,0 +1,53 @@
+/*
+ * Market Canopy Office: styles of the About notices.
+ * Copyright (C) 2026 Market Canopy LLC
+ * SPDX-License-Identifier: AGPL-3.0-only (with the additional terms in the
+ * LICENSE file of https://github.com/marketcanopy/office)
+ */
+
+.mc-notice {
+  max-height: 40vh;
+  overflow-y: auto;
+  margin-top: 12px;
+  padding-top: 12px;
+  border-top: 1px solid var(--border-divider);
+
+  p.about-field {
+    margin: 0 0 8px;
+    font-size: 12px;
+    line-height: 18px;
+  }
+}
+
+.mc-notice-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 16px;
+}
+
+.mc-notice-texts summary {
+  cursor: pointer;
+}
+
+.mc-notice-texts summary:focus-visible,
+.mc-notice-text:focus-visible {
+  outline: 2px solid var(--text-link, #2080e5);
+  outline-offset: 2px;
+}
+
+.mc-notice-heading {
+  font-size: 12px;
+  font-weight: 700;
+  margin: 12px 0 4px;
+  color: var(--text-normal);
+}
+
+.mc-notice-text {
+  max-height: 200px;
+  overflow: auto;
+  white-space: pre-wrap;
+  font-size: 11px;
+  line-height: 15px;
+  margin: 0;
+  color: var(--text-secondary);
+}
