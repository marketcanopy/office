+ * AGPL at https://www.gnu.org/licenses/agpl-3.0.html.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+// The native account module (desktop-sdk src/marketcanopy) owns everything:
+// this only keeps its last published state and sends the person's choices.
+// It never sees a token, a code or a device id. The sidebar imports it, so it
+// listens for as long as the start page is open, whichever page shows.
+import { createSignal } from "solid-js";
+import { onNativeMessage } from "@/sdk/events.js";
+import { command } from "@/sdk/bridge.js";
+
+const [account, setAccount] = createSignal(null);
+export { account };
+
+export function sendAccount(action, extra) {
+  command("mc:account", { action, ...extra });
+}
+
+onNativeMessage((cmd, param) => {
+  if (cmd !== "mc:account") return;
+  try {
+    setAccount(JSON.parse(param));
+  } catch {
+    // a malformed state leaves the last one on screen
+  }
+});
+// SPEC 5.4 rule 5: a signed-out Office reads the credential store again when its window gains focus
+window.addEventListener("focus", () => sendAccount("activate"));
+sendAccount("state");
