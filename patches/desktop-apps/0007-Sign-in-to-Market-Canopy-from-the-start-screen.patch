+// The native account module (desktop-sdk src/marketcanopy) owns everything:
+// this only shows its state and sends the person's choices. It never sees a
+// token, a code or a device id. Market Canopy's cloud connection is set up by
+// native code after sign-in, so there is no "connect a cloud" step.
+import { For, Match, Show, Switch, createSignal, onCleanup, onMount } from "solid-js";
+import { onNativeMessage } from "@/sdk/events.js";
+import { command } from "@/sdk/bridge.js";
+import { t } from "@/services/l10n.js";
+import { Button } from "@/components";
+import "./MarketCanopyAccount.styles.css";
+
+function send(action, extra) {
+  command("mc:account", { action, ...(extra ?? {}) });
+}
+
+export function MarketCanopyAccount() {
+  const [account, setAccount] = createSignal(null);
+
+  onMount(() => {
+    const unsub = onNativeMessage((cmd, param) => {
+      if (cmd !== "mc:account") return;
+      try {
+        setAccount(JSON.parse(param));
+      } catch {
+        // a malformed state leaves the last one on screen
+      }
+    });
+    // SPEC 5.4 rule 5: a signed-out Office reads the credential store again when its window gains focus
+    const activate = () => send("activate");
+    window.addEventListener("focus", activate);
+    send("state");
+    onCleanup(() => {
+      unsub();
+      window.removeEventListener("focus", activate);
+    });
+  });
+
+  const state = () => account()?.state ?? "starting";
+  const organizations = () => account()?.organizations ?? [];
+
+  return (
+    <section class="mc-account" aria-live="polite">
+      <Switch>
+        <Match when={state() === "starting" || state() === "connecting"}>
+          <p class="mc-account-text">{t("mcAccountConnecting", "Connecting to Market Canopy...")}</p>
+        </Match>
+        <Match when={state() === "signing_in"}>
+          <p class="mc-account-text">{t("mcAccountFinishInBrowser", "Finish signing in in your browser.")}</p>
+          <Button onClick={() => send("cancelSignIn")}>{t("btnCancel", "Cancel")}</Button>
+        </Match>
+        <Match when={state() === "signed_in" || state() === "no_organization" || state() === "offline"}>
+          <p class="mc-account-text">
+            <Show when={account()?.user} fallback={t("mcAccountSignedIn", "Signed in to Market Canopy")}>
+              {t("mcAccountSignedInAs", "Signed in to Market Canopy as $1").replace("$1", account().user.displayName || account().user.email)}
+            </Show>
+          </p>
+          <Show when={state() === "offline"}>
+            <p class="mc-account-note">{t("mcAccountOffline", "Market Canopy can't be reached. Local files still open and save.")}</p>
+          </Show>
+          <Show when={state() === "no_organization"}>
+            <p class="mc-account-note">{t("mcAccountChooseOrganization", "Choose an organization to use Market Canopy.")}</p>
+          </Show>
+          <Show when={organizations().length > 1 || state() === "no_organization"}>
+            <select
+              class="mc-account-organization"
+              aria-label={t("mcAccountOrganization", "Organization")}
+              value={account()?.activeOrganizationId ?? ""}
+              onChange={(e) => e.currentTarget.value && send("selectOrganization", { organizationId: e.currentTarget.value })}
+            >
+              <Show when={!account()?.activeOrganizationId}>
+                <option value="">{t("mcAccountChoose", "Choose...")}</option>
+              </Show>
+              <For each={organizations()}>{(org) => <option value={org.id}>{org.name}</option>}</For>
+            </select>
+          </Show>
+          <Button onClick={() => send("signOut")}>{t("mcAccountSignOut", "Sign out")}</Button>
+        </Match>
+        <Match when={state() === "update_required"}>
+          <p class="mc-account-text">{t("mcAccountUpdateRequired", "Update required")}</p>
+          <p class="mc-account-note">
+            {t("mcAccountUpdateNote", "Market Canopy cloud and AI need a newer version of Office. Local files still open and save.")}
+          </p>
+          <Show when={account()?.update?.storeUrl}>
+            <Button variant="accent" onClick={() => send("openStore")}>{t("mcAccountGetUpdate", "Get the update")}</Button>
+          </Show>
+        </Match>
+        <Match when={true}>
+          <Button variant="accent" onClick={() => send("signIn")}>{t("mcAccountSignIn", "Sign in to Market Canopy")}</Button>
+          <Show when={account()?.credentialStore === "unavailable"}>
+            <p class="mc-account-note">
+              {t("mcAccountMemoryOnly", "This computer has no secure credential store, so you stay signed in only until Office closes.")}
+            </p>
+          </Show>
+          <Show when={account()?.error && account().error !== "SIGNED_OUT"}>
+            <p class="mc-account-note">{t("mcAccountCouldNotConnect", "Couldn't connect to Market Canopy. Try again.")}</p>
+          </Show>
+        </Match>
+      </Switch>
+    </section>
+  );
+}
