+
+// Laid out like upstream's available clouds: one row for each organization
+// the person belongs to, with the organization's logo (its settings' logo,
+// else upstream's generic cloud), its name and Connect. Signing out is the
+// web page's (its sign-out reaches the account module through portal:logout),
+// so no row offers Log out or Remove. Market Canopy's cloud connection is
+// made by native code after sign-in: Connect selects the organization when it
+// is not the active one, then opens the provider's startPage, whose load the
+// account module connects before the page shows the drive.
+import { For, Match, Show, Switch, createEffect, createSignal } from "solid-js";
+import { openPortal, relpath } from "@/sdk/portals.js";
+import { t } from "@/services/l10n.js";
+import { Button } from "@/components";
+import { account, sendAccount } from "@/stores/marketcanopy.js";
+import "./clouds.css";
+import "./MarketCanopy.styles.css";
+
+function MarketCanopyIcon() {
+  const base = `${relpath}/providers/marketcanopy/assets`;
+  return (
+    <div class="provider-icon">
+      <img class="icon icon__light" src={`${base}/listicon.svg`} alt="" />
+      <img class="icon icon__dark" src={`${base}/listicon_dark.svg`} alt="" />
+    </div>
+  );
+}
+
+function OrganizationLogo(props) {
+  const [failed, setFailed] = createSignal(false);
+  return (
+    <div class="provider-icon">
+      <Show
+        when={props.logoUrl && !failed()}
+        fallback={
+          <svg class="icon">
+            <use href="#cloud" />
+          </svg>
+        }
+      >
+        <img src={props.logoUrl} alt="" onError={() => setFailed(true)} />
+      </Show>
+    </div>
+  );
+}
+
+function OrganizationItem(props) {
+  return (
+    <div class="provider-item" onClick={() => props.onOpen(props.organization)}>
+      <OrganizationLogo logoUrl={props.organization.logoUrl} />
+      <span class="provider-name" title={props.organization.name}>
+        {props.organization.name}
+      </span>
+      <Button variant="default" class="provider-connect-btn">
+        {t("btnConnectAction", "Connect")}
+      </Button>
+    </div>
+  );
+}
+
+export default function MarketCanopy() {
+  // The organization to open once the account module has made it the active one.
+  const [pending, setPending] = createSignal(null);
+  const state = () => account()?.state ?? "starting";
+  const docsAvailable = () => !!(account()?.docs?.enabled && account()?.appOrigin);
+
+  function openDocuments() {
+    if (docsAvailable()) openPortal(account().appOrigin, "marketcanopy", "/office/connect");
+  }
+
+  function open(organization) {
+    if (organization.id === account()?.activeOrganizationId && state() === "signed_in") {
+      setPending(null);
+      openDocuments();
+      return;
+    }
+    setPending(organization.id);
+    sendAccount("selectOrganization", { organizationId: organization.id });
+  }
+
+  createEffect(() => {
+    if (!pending() || state() !== "signed_in" || account()?.activeOrganizationId !== pending()) return;
+    setPending(null);
+    openDocuments();
+  });
+
+  return (
+    <div class="clouds-page mc-cloud" aria-live="polite">
+      <Switch>
+        <Match when={state() === "starting" || (state() === "connecting" && !account()?.organizations?.length)}>
+          <section>
+            <p class="mc-cloud-note">{t("mcAccountConnecting", "Connecting to Market Canopy...")}</p>
+          </section>
+        </Match>
+        <Match when={state() === "signing_in"}>
+          <section>
+            <h2 class="clouds-section-title">Market Canopy</h2>
+            <div class="provider-item">
+              <MarketCanopyIcon />
+              <span class="provider-name">{t("mcAccountFinishInBrowser", "Finish signing in in your browser.")}</span>
+              <Button variant="default" class="provider-connect-btn" onClick={() => sendAccount("cancelSignIn")}>
+                {t("btnCancel", "Cancel")}
+              </Button>
+            </div>
+          </section>
+        </Match>
+        <Match when={state() === "update_required"}>
+          <section>
+            <h2 class="clouds-section-title">Market Canopy</h2>
+            <p class="mc-cloud-note">{t("mcAccountUpdateRequired", "Update required")}</p>
+            <p class="mc-cloud-note">
+              {t("mcAccountUpdateNote", "Market Canopy cloud and AI need a newer version of Office. Local files still open and save.")}
+            </p>
+            <Show when={account()?.update?.storeUrl}>
+              <Button variant="accent" onClick={() => sendAccount("openStore")}>{t("mcAccountGetUpdate", "Get the update")}</Button>
+            </Show>
+          </section>
+        </Match>
+        <Match when={["signed_in", "no_organization", "offline", "connecting"].includes(state())}>
+          <section>
+            <Show when={state() === "offline"}>
+              <p class="mc-cloud-note">{t("mcAccountOffline", "Market Canopy can't be reached. Local files still open and save.")}</p>
+            </Show>
+            <Show when={state() === "signed_in" && !docsAvailable() && !pending()}>
+              <p class="mc-cloud-note">{t("mcDocumentsUnavailable", "Market Canopy documents aren't available in this organization.")}</p>
+            </Show>
+            <div class="provider-list">
+              <For each={account()?.organizations ?? []}>
+                {(organization) => <OrganizationItem organization={organization} onOpen={open} />}
+              </For>
+            </div>
+          </section>
+        </Match>
+        <Match when={true}>
+          <section>
+            <h2 class="clouds-section-title">Market Canopy</h2>
+            <div class="provider-item" onClick={() => sendAccount("signIn")}>
+              <MarketCanopyIcon />
+              <span class="provider-name">Market Canopy</span>
+              <Button variant="default" class="provider-connect-btn">{t("mcCloudSignIn", "Sign in")}</Button>
+            </div>
+            <Show when={account()?.credentialStore === "unavailable"}>
+              <p class="mc-cloud-note">
+                {t("mcAccountMemoryOnly", "This computer has no secure credential store, so you stay signed in only until Office closes.")}
+              </p>
+            </Show>
+            <Show when={account()?.error && account().error !== "SIGNED_OUT"}>
+              <p class="mc-cloud-note">{t("mcAccountCouldNotConnect", "Couldn't connect to Market Canopy. Try again.")}</p>
+            </Show>
+          </section>
+        </Match>
+      </Switch>
+    </div>
+  );
+}
