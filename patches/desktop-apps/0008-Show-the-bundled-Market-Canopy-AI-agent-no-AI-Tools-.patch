From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Market Canopy <office@marketcanopy.invalid>
Date: Sun, 25 Oct 2026 00:00:00 +0000
Subject: [PATCH] Show the bundled Market Canopy AI agent; no AI Tools page

ADR 0525: the AI agent that ships in desktop-sdk is Office's only AI
surface, with Market Canopy as its only provider, and the vendor's BSL
add-on is never installed. Upstream reports the bundled agent as
integrated only in its own branded builds (OO_BRANDING, which
build_tools never defines), so the start screen's AI item asked to
install the add-on instead of opening the agent. The status is now sent
in every build that is not in add-on mode, under the name Market Canopy
AI.

The AI Tools item opened the add-on's tool gallery, which Office does
not have, so it is removed.
---
 common/loginpage/src/shell/Sidebar.jsx | 21 +--------------------
 win-linux/src/windows/cmainwindow.cpp  |  5 +++--
 2 files changed, 4 insertions(+), 22 deletions(-)

diff --git a/common/loginpage/src/shell/Sidebar.jsx b/common/loginpage/src/shell/Sidebar.jsx
index 40bf021..f9f0c26 100644
--- a/common/loginpage/src/shell/Sidebar.jsx
+++ b/common/loginpage/src/shell/Sidebar.jsx
@@ -10,6 +10,7 @@ import { aichat, closeSidePanel, openFullAIPanel } from "@/stores/aichat.js";
 import "./Sidebar.styles.css";
 // Modified by Market Canopy on 2026-10-24 for Market Canopy Office: no Clouds menu
 // item; Office connects to Market Canopy by itself.
+// Modified by Market Canopy on 2026-10-25 for Market Canopy Office: no AI Tools page (the add-on's tool gallery).
 // import { sendPluginVisibility } from "@/services/ai-panel.js";
 
 export default function Sidebar() {
@@ -38,23 +39,6 @@ export default function Sidebar() {
     }
   };
 
-  const clickAiTools = (e) => {
-    if (aichat.available) {
-      if (addonInfo()?.restart === true) {
-        e.preventDefault();
-        command('addon:action', 'askrestart');
-      } else if (addonInfo()?.compatible === false) {
-        e.preventDefault();
-        command('addon:action', 'incompatible');
-      }
-      // closeSidePanel();
-      // href handles navigation
-    } else {
-      e.preventDefault();
-      command('addon:action', 'intro');
-    }
-  };
-
   return (
     <nav class="tool-menu">
       <Show when={appliedUseAi()}>
@@ -64,9 +48,6 @@ export default function Sidebar() {
       <MenuItem href="/" icon="#home" label={t("actHome")} end />
       <MenuItem href="/open" icon="#folder" label={t("actOpenLocal")} />
       <MenuItem action="templates" href="/templates" icon="#templates" label={t("actTemplates")} />
-      <Show when={appliedUseAi()}>
-        <MenuItem href="/aitools" onClick={clickAiTools} icon="#aitools" label={t("actAiTools", "AI Tools")} />
-      </Show>
       <For each={extPlugins()}>
         {(plugin) => (
           <MenuItem
