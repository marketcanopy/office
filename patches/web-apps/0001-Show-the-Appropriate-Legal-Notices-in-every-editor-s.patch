From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Market Canopy <office@marketcanopy.invalid>
Date: Sat, 24 Oct 2026 00:00:00 +0000
Subject: [PATCH] Show the Appropriate Legal Notices in every editor's About

The editors' About names the original developer, the modification dates,
the build, the license, the warranty disclaimer and the source of this
build, and holds the license texts for offline reading. The template is
written by the branding's build_tools hook. The address, mail and phone
rows go: the build would otherwise fill them with ONLYOFFICE's.
---
 apps/common/main/lib/view/About.js | 31 ++++++++----------------------
 1 file changed, 8 insertions(+), 23 deletions(-)

diff --git a/apps/common/main/lib/view/About.js b/apps/common/main/lib/view/About.js
index ab1d7088..fd03a603 100644
--- a/apps/common/main/lib/view/About.js
+++ b/apps/common/main/lib/view/About.js
@@ -31,6 +31,10 @@
  * Public License v3.
  *
  * SPDX-License-Identifier: AGPL-3.0-only
+ *
+ * Modified by Market Canopy on 2026-10-24 for Market Canopy Office: About shows
+ * the Appropriate Legal Notices and no longer the licensor's address, mail and
+ * phone rows.
  */
 /**
  *  About.js
@@ -40,9 +44,10 @@
  */
 
 define([
+    'text!common/main/lib/template/MarketCanopyNotice.template',
     'common/main/lib/component/BaseView',
     'common/main/lib/component/Scroller'
-], function () { 'use strict';
+], function (noticeTemplate) { 'use strict';
 
     Common.Views.About = Common.UI.BaseView.extend(_.extend({
         menu: undefined,
@@ -77,24 +82,6 @@ define([
                     '<tr>',
                         '<td colspan="3" align="center" style="padding: 20px 0 10px 0;"><label class="asc-about-companyname"><%= publishername %></label></td>',
                     '</tr>',
-                    '<tr>',
-                        '<td colspan="3" align="center" class="padding-small">',
-                        '<label class="asc-about-desc-name">' + this.txtAddress + '</label>',
-                        '<label class="asc-about-desc"><%= publisheraddr %></label>',
-                        '</td>',
-                    '</tr>',
-                    '<tr>',
-                        '<td colspan="3" align="center" class="padding-small">',
-                        '<label class="asc-about-desc-name">' + this.txtMail + '</label>',
-                        '<a href="mailto:<%= supportemail %>"><%= supportemail %></a>',
-                        '</td>',
-                    '</tr>',
-                    '<tr>',
-                        '<td colspan="3" align="center" class="padding-small">',
-                        '<label class="asc-about-desc-name">' + this.txtTel + '</label>',
-                        '<label class="asc-about-desc" dir="ltr"><%= phonenum %></label>',
-                        '</td>',
-                    '</tr>',
                     '<tr>',
                         '<td colspan="3" align="center">',
                         '<a href="<%= publisherurl %>" target="_blank"><% print(publisherurl.replace(/https?:\\/{2}/, "").replace(/\\/$/,"")) %></a>',
@@ -159,7 +146,8 @@ define([
                             '<a href="<%= publisherurl %>" target="_blank"><% print(publisherurl.replace(/https?:\\/{2}/, "").replace(/\\/$/,"")) %></a>',
                         '</td>',
                     '</tr>',
-                '</table>'
+                '</table>',
+                noticeTemplate
             ].join(''));
             this.menu = options.menu;
         },
@@ -170,10 +158,7 @@ define([
 
                 var _$l = $(this.template({
                     publishername: '{{PUBLISHER_NAME}}',
-                    publisheraddr: '{{PUBLISHER_ADDRESS}}',
                     publisherurl: '{{PUBLISHER_URL}}',
-                    supportemail: '{{SUPPORT_EMAIL}}',
-                    phonenum: '{{PUBLISHER_PHONE}}',
                     scope: this
                 }));
 
