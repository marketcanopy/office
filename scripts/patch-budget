# Usage: scripts/patch-budget > docs/branding/patch-budget.md
# Counts as office-build does (build/officebuild/patches.py): added plus
# removed lines in files that exist upstream; new files are excluded.

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "build"))

from officebuild import patches  # noqa: E402


def subject(path):
    with open(path, "r", encoding="utf-8", errors="replace") as handle:
        lines = handle.read().splitlines()
    for index, line in enumerate(lines):
        if line.startswith("Subject: "):
            text = line[len("Subject: ") :]
            for follow in lines[index + 1 :]:
                if not follow.startswith(" "):
                    break
                text += follow
            return text.replace("[PATCH] ", "").strip()
    return ""


def files(path):
    names = []
    new = set()
    with open(path, "r", encoding="utf-8", errors="replace") as handle:
        current = None
        for line in handle:
            if line.startswith("diff --git "):
                current = line.split(" b/", 1)[1].strip()
                names.append(current)
            elif line.startswith("new file mode") and current:
                new.add(current)
    return names, new


def main():
    inventory = patches.inventory(ROOT)
    print("# Patch queue and budget")
    print()
    print(
        "Generated by `scripts/patch-budget`. Budget (ADR 0529 decision 2): at most %d patches and %d changed"
        % (patches.BUDGET_PATCHES, patches.BUDGET_LINES)
    )
    print("upstream lines; new files do not count.")
    print()
    print("**%s**" % patches.budget_line(inventory))
    print()
    print("| Patch | Subject | Changed upstream lines | Upstream files changed | New files |")
    print("|---|---|---|---|---|")
    for patch in inventory:
        names, new = files(patch.path)
        changed = [name for name in names if name not in new]
        print(
            "| `%s` | %s | %d | %s | %s |"
            % (
                os.path.relpath(patch.path, ROOT).replace(os.sep, "/"),
                subject(patch.path),
                patch.changed_lines,
                "<br>".join("`%s`" % name for name in changed) or "none",
                "<br>".join("`%s`" % name for name in sorted(new)) or "none",
            )
        )


if __name__ == "__main__":
    main()
